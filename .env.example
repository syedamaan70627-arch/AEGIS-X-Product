# AEGIS-X Environment Configuration Template
# Copy this file to .env for local overrides (never commit real credentials to git)

# Application Environment: development | production
AEGIS_ENV=development

# Authentication Mode: false (development identity) | true (require Supabase Bearer token)
AUTH_REQUIRED=false

# Persistence Backends: sqlite | supabase
DATABASE_BACKEND=sqlite

# Storage Backends: local | supabase
STORAGE_BACKEND=local

# Supabase Project Credentials (required when DATABASE_BACKEND=supabase or STORAGE_BACKEND=supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder
SUPABASE_STORAGE_BUCKET=aegis-private

# CORS Configured Origins (comma-separated, no wildcards with credentials)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# File Upload Limit (bytes, default 50MB)
AEGIS_MAX_UPLOAD_SIZE=52428800
